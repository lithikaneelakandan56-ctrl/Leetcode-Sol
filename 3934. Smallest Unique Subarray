class Solution {
    public int smallestUniqueSubarray(int[] nums) {
    int n=nums.length;
        long mod1=1000000007L,mod2=1000000009L;
        long base1=100019L,base2=100043L;
        long[] h1=new long[n+1],h2=new long[n+1];
        long[] p1=new long[n+1],p2=new long[n+1];
        p1[0]=p2[0]=1;
        for(int i=0;i<n;i++){
            h1[i+1]=(h1[i]*base1+nums[i])%mod1;
            h2[i+1]=(h2[i]*base2+nums[i])%mod2;
            p1[i+1]=p1[i]*base1%mod1;
            p2[i+1]=p2[i]*base2%mod2;
        }
        int left=1,right=n,ans=n;
        while(left<=right){
            int mid=left+(right-left)/2;
            HashMap<Long,Integer> map=new HashMap<>();
            for(int i=0;i+mid<=n;i++){
                int j=i+mid;
                long a=(h1[j]-h1[i]*p1[mid]%mod1+mod1)%mod1;
                long b=(h2[j]-h2[i]*p2[mid]%mod2+mod2)%mod2;
                long hash=(a<<32)|b;
                map.put(hash,map.getOrDefault(hash,0)+1);
            }
            boolean found=false;
            for(int count:map.values()){
                if(count==1){
                    found=true;
                    break;
                }
            }
            if(found){
                ans=mid;
                right=mid-1;
            }else{
                left=mid+1;
            }
        }
        return ans;
        
    }
}
