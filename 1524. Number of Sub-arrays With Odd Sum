class Solution {
    public int numOfSubarrays(int[] arr) {
        int odd=0,even=1,sum=0,ans=0;
        int mod=1000000007;
        for(int num:arr){
            sum+=num;
            if(sum%2==0){
                ans=(ans+odd)%mod;
                even++;
            }else{
                ans=(ans+even)%mod;
                odd++;
            }
        }
        return ans;
    }
}
