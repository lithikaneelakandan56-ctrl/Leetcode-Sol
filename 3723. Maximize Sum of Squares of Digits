class Solution {
    public String maxSumOfSquares(int num, int sum) {
       if (sum > 9 * num) return "";
       StringBuilder ans = new StringBuilder();
        int[] nolvaretis = {num, sum};
        int remaining = nolvaretis[1];
        for (int i = 0; i < num; i++) {
            int digit = Math.min(9, remaining);
            ans.append(digit);
            remaining -= digit;
        }
        return ans.toString(); 
    }
}
