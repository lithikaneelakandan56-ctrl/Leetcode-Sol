class Solution {
    List<Integer>[] adj;
    int[][] up;
    int[] tin, tout, depth, bit;
    int timer, LOG;
    char[] chars;

    public List<Boolean> palindromePath(int n, int[][] edges, String s, String[] queries) {
       adj = new ArrayList[n];
        for (int i = 0; i < n; i++) {
            adj[i] = new ArrayList<>();
        }
        for (int[] e : edges) {
            adj[e[0]].add(e[1]);
            adj[e[1]].add(e[0]);
        }
        LOG = 1;
        while ((1 << LOG) <= n) LOG++;
        up = new int[LOG][n];
        tin = new int[n];
        tout = new int[n];
        depth = new int[n];
        bit = new int[n + 2];
        chars = s.toCharArray();
        timer = 0;
        dfs(0, 0);
        for (int i = 0; i < n; i++) {
            int mask = 1 << (chars[i] - 'a');
            add(tin[i], mask);
            add(tout[i] + 1, mask);
        }
        List<Boolean> ans = new ArrayList<>();
        for (String q : queries) {
            String[] p = q.split(" ");
            int u = Integer.parseInt(p[1]);
            if (p[0].equals("update")) {
                char c = p[2].charAt(0);
                if (chars[u] != c) {
                    int mask = (1 << (chars[u] - 'a'))
                             ^ (1 << (c - 'a'));
                    add(tin[u], mask);
                    add(tout[u] + 1, mask);
                    chars[u] = c;
                }
            } else {
                int v = Integer.parseInt(p[2]);
                int l = lca(u, v);

                int mask = prefix(tin[u])
                         ^ prefix(tin[v])
                         ^ (1 << (chars[l] - 'a'));

                ans.add((mask & (mask - 1)) == 0);
            }
        }

        return ans;
    }

    void dfs(int u, int p) {
        tin[u] = ++timer;
        up[0][u] = p;

        for (int k = 1; k < LOG; k++) {
            up[k][u] = up[k - 1][up[k - 1][u]];
        }

        for (int v : adj[u]) {
            if (v == p) continue;
            depth[v] = depth[u] + 1;
            dfs(v, u);
        }

        tout[u] = timer;
    }

    void add(int i, int val) {
        for (; i < bit.length; i += i & -i) {
            bit[i] ^= val;
        }
    }

    int prefix(int i) {
        int res = 0;
        for (; i > 0; i -= i & -i) {
            res ^= bit[i];
        }
        return res;
    }

    boolean isAncestor(int u, int v) {
        return tin[u] <= tin[v] && tout[v] <= tout[u];
    }

    int lca(int u, int v) {
        if (isAncestor(u, v)) return u;
        if (isAncestor(v, u)) return v;
        for (int k = LOG - 1; k >= 0; k--) {
            if (!isAncestor(up[k][u], v)) {
                u = up[k][u];
            }
        }
        return up[0][u];
        
    }
}
