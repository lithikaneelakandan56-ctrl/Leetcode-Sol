class Solution{
    public int minimumChanges(String s,int k){
        int n=s.length();
        int[][] cost=new int[n][n];
        for(int len=2;len<=n;len++){
            for(int i=0;i+len<=n;i++){
                int j=i+len-1;
                cost[i][j]=Integer.MAX_VALUE;
                for(int d=1;d<len;d++){
                    if(len%d!=0)continue;
                    int c=0;
                    for(int r=0;r<d;r++){
                        int l=i+r;
                        int h=i+r+((len-1-r)/d)*d;
                        while(l<h){
                            if(s.charAt(l)!=s.charAt(h))c++;
                            l+=d;
                            h-=d;
                        }
                    }
                    cost[i][j]=Math.min(cost[i][j],c);
                }
            }
        }
        int[][] dp=new int[k+1][n+1];
        for(int[] row:dp)Arrays.fill(row,100000);
        dp[0][0]=0;
        for(int i=1;i<=k;i++){
            for(int j=2*i;j<=n;j++){
                for(int p=2*(i-1);p<=j-2;p++){
                    dp[i][j]=Math.min(dp[i][j],dp[i-1][p]+cost[p][j-1]);
                }
            }
        }
        return dp[k][n];
    }
}
