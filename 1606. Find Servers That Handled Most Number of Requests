class Solution {
    public List<Integer> busiestServers(int k, int[] arrival, int[] load) {
      int n = arrival.length;

        int[] count = new int[k];

        TreeSet<Integer> free = new TreeSet<>();

        PriorityQueue<int[]> busy = new PriorityQueue<>(
            (a, b) -> Integer.compare(a[0], b[0])
        );

        for (int i = 0; i < k; i++) {
            free.add(i);
        }

        for (int i = 0; i < n; i++) {
            int time = arrival[i];

            // Release servers that have completed their requests
            while (!busy.isEmpty() && busy.peek()[0] <= time) {
                int[] server = busy.poll();
                free.add(server[1]);
            }

            if (free.isEmpty()) {
                continue;
            }

            int preferred = i % k;

            // Find the next available server
            Integer server = free.ceiling(preferred);

            // Wrap around if needed
            if (server == null) {
                server = free.first();
            }

            free.remove(server);

            count[server]++;

            busy.offer(new int[]{
                time + load[i],
                server
            });
        }

        int max = 0;

        for (int c : count) {
            max = Math.max(max, c);
        }

        List<Integer> result = new ArrayList<>();

        for (int i = 0; i < k; i++) {
            if (count[i] == max) {
                result.add(i);
            }
        }

        return result;  
    }
}
