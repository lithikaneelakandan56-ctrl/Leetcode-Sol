class Solution {
    public int maxLength(int[] nums) {
        int n=nums.length;
        int ans=0;
        for(int i=0;i<n;i++){
            long product=1;
            int gcd=0,lcm=1;
            for(int j=i;j<n;j++){
                product*=nums[j];
                gcd=gcd(gcd,nums[j]);
                lcm=lcm/gcd(lcm,nums[j])*nums[j];
                if(product==(long)gcd*lcm){
                    ans=Math.max(ans,j-i+1);
                }
                if(product>25200)break;
            }
        }
        return ans;
    }
    private int gcd(int a,int b){
        while(b!=0){
            int t=a%b;
            a=b;
            b=t;
        }
        return a;
    }
}
